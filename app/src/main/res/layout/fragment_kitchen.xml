<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THÊM MÓN THỬ NGHIỆM (KITCHEN)"
        android:textStyle="bold"
        android:textColor="#333333"
        android:textSize="18sp"
        android:layout_marginBottom="12dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/edtTableName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Nhập tên bàn (VD: Bàn 05)"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:textColor="#333333"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/edtFoodName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Nhập tên món ăn"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:textColor="#333333"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/edtQuantity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Nhập số lượng"
                android:inputType="number"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:textColor="#333333"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/btnAddNewOrder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="GỬI MÓN VÀO BẾP"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DANH SÁCH MÓN ĐANG XỬ LÝ"
        android:textStyle="bold"
        android:textColor="#333333"
        android:textSize="18sp"
        android:layout_marginBottom="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvKitchen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="20dp"/>

</LinearLayout>
