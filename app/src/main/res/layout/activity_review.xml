<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <ImageView
            android:id="@+id/btnBackReview"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:text="ĐÁNH GIÁ"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cảm nhận của bạn"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sự hài lòng của bạn là động lực của chúng tôi."
                android:textColor="#BDBDBD"
                android:textSize="14sp"/>

            <!-- RATING STARS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#111111"
                app:cardCornerRadius="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView android:id="@+id/star1" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/ic_star_empty" app:tint="#FFD54F" android:padding="4dp"/>
                    <ImageView android:id="@+id/star2" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/ic_star_empty" app:tint="#FFD54F" android:padding="4dp"/>
                    <ImageView android:id="@+id/star3" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/ic_star_empty" app:tint="#FFD54F" android:padding="4dp"/>
                    <ImageView android:id="@+id/star4" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/ic_star_empty" app:tint="#FFD54F" android:padding="4dp"/>
                    <ImageView android:id="@+id/star5" android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/ic_star_empty" app:tint="#FFD54F" android:padding="4dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PHONE (Hidden if logged in) -->
            <EditText
                android:id="@+id/etUserPhone"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_input"
                android:hint="Số điện thoại của bạn"
                android:inputType="phone"
                android:paddingHorizontal="18dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:visibility="gone"/>

            <!-- FEEDBACK CONTENT -->
            <EditText
                android:id="@+id/etReviewContent"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="Nội dung đánh giá (không bắt buộc)..."
                android:padding="18dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"/>

            <!-- BUTTON -->
            <Button
                android:id="@+id/btnSubmitReview"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#E50914"
                android:text="GỬI ĐÁNH GIÁ"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>