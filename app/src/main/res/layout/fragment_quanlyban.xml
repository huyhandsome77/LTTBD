<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/admin_primary"
            android:text="Tất cả"
            android:textSize="11sp"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnFilterUsing"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#ECEFF1"
            android:text="Sử dụng"
            android:textSize="11sp"
            android:textColor="#555555" />

        <Button
            android:id="@+id/btnFilterEmpty"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#ECEFF1"
            android:text="Trống"
            android:textSize="11sp"
            android:textColor="#555555" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTables"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:listitem="@layout/item_table" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@color/table_using" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Sử dụng   "
            android:textSize="11sp"
            android:textColor="@android:color/black"/>

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@color/table_reserved" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Đã đặt   "
            android:textSize="11sp"
            android:textColor="@android:color/black"/>

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@color/table_empty" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Trống"
            android:textSize="11sp"
            android:textColor="@android:color/black"/>
    </LinearLayout>

</LinearLayout>