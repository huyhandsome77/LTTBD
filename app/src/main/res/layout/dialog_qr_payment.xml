<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quét Mã QR Thanh Toán"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:id="@+id/ivPaymentQR"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvBankInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ngân hàng: Vietcombank\nSTK: 05230500xxxx\nTên: NHA HANG APP DAT MON"
        android:gravity="center"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvQRTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số tiền: 230.000đ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvTransactionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trạng thái: Chờ khách chuyển khoản..."
        android:textColor="#E65100"
        android:textStyle="italic"/>

    <Button
        android:id="@+id/btnCloseQR"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Đóng"
        android:backgroundTint="#757575"/>
</LinearLayout>